# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# test build output (npm test)
# Нэмэлт build хавтаснууд (.next-test — тестийн сервер, бусад — локал
# preview). Tailwind v4 нь gitignore-д байхгүй бүхнийг класс хайж скан хийдэг
# тул энд байхгүй бол шахсан кэш файлаас эвдэрсэн CSS үүсгэж, зэрэг
# ажиллаж буй dev/тест серверийг унагадаг — 2026-09-29-нд болсон.
/.next-*/
